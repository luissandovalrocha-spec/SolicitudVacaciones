<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Objeto didáctico reutilizado del taller de Salesforce Flow para practicar la integración LWC + Screen Flow.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Solicitud de Vacaciones</label>
    <nameField>
        <displayFormat>SV-{0000}</displayFormat>
        <label>Número de solicitud</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Solicitudes de Vacaciones</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
